# Configuración local no versionada para los scripts y skills de ~/rules.
# Copia este archivo a .env y llena los valores; sync_global.sh copia .env a ~/rules/.env con permisos 600.
# Aquí viven las credenciales y todo dato sensible (hosts, IP, sitios, contactos); nunca en archivos versionados.

# Credenciales Atlassian (Jira y Confluence) para scripts/atlassian/
JIRA_USER_EMAIL="replace_with_user_email"
JIRA_USER_TOKEN="replace_with_api_token"   # https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_DEV="https://<sitio-dev>.atlassian.net"
JIRA_BASE_OPS="https://<sitio-ops>.atlassian.net"
CONFLUENCE_BASE="https://<sitio>.atlassian.net/wiki"

# Menciones por defecto en los comentarios de /sdd-readiness: "accountId|Nombre" separados por coma
SDD_READINESS_MENTIONS="712020:00000000-0000-0000-0000-000000000000|Nombre Apellido"

# Plantilla de correo de entrega (/mail delivery): infraestructura del ambiente
MAIL_GATEWAY_IP="<ip_gateway_istio>"
MAIL_JENKINS_URL="http://<host_jenkins>:8080/jenkins"
MAIL_JENKINS_FOLDER="<carpeta_de_jobs>"
MAIL_K8S_NAMESPACE="<namespace>"

# Pie de documentos LaTeX corporativos
LATEX_CONTACT_ADDRESS="<calle y número, alcaldía>"
LATEX_CONTACT_PHONE="+52 (55) 0000-0000"
