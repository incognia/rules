{
  "name": "rules",
  "private": true,
  "version": "0.0.0",
  "description": "Reglas y filosofía profesional y académica (.md) con lint y verificación de enlaces",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\"",
    "check:links": "find . -name '*.md' -not -path './node_modules/*' -not -path './.git/*' -not -path './backups/*' -print0 | xargs -0 -n1 markdown-link-check -q -c .markdownlinkcheck.json",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "markdown-link-check": "3.15.0",
    "markdownlint-cli2": "0.23.3"
  }
}
